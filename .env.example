# Copy to .env (never committed) and fill in ANTHROPIC_API_KEY.

# Admin connection: owns the tables, used only by scripts/reset_db.py and tests that set up data.
DATABASE_URL_ADMIN=postgresql://localhost/contexthub
# App connection: role hub_app. The app must never connect as the table owner (owners bypass grants).
DATABASE_URL_APP=postgresql://hub_app@localhost/contexthub
# Archive writes only (role hub_archiver): raw transcripts, never read by the app.
DATABASE_URL_ARCHIVER=postgresql://hub_archiver@localhost/contexthub
# Demo UI audit tabs only (role hub_ui, SELECT only). Optional: defaults to DATABASE_URL_APP with user hub_ui.
DATABASE_URL_UI=postgresql://hub_ui@localhost/contexthub

ANTHROPIC_API_KEY=
# Agent replies and tool choice.
MODEL_ID=claude-sonnet-5-5
# Memory extraction and SUM-baseline grading (cheaper model).
EXTRACTION_MODEL_ID=claude-haiku-5-5
# auto (default: recorded answers replay, new ones call the API once and are saved) | replay (no network)
# | record (CLI only, re-records) | live (always calls, saves nothing). pytest always uses replay.
LLM_MODE=auto
# Hard stop on paid (record/live) calls, in USD, summed from results/llm_usage.csv.
LLM_BUDGET_USD=10

# A bank callback is Missed when the clock reaches due_at + this many minutes with no dialler record.
MISSED_THRESHOLD_MINUTES=15

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
