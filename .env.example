# Copy to .env (never committed) and fill in ANTHROPIC_API_KEY.

# Admin connection: owns the tables, used only by scripts/reset_db.py and tests that set up data.
DATABASE_URL_ADMIN=postgresql://localhost/contexthub
# App connection: role hub_app. The app must never connect as the table owner (owners bypass grants).
DATABASE_URL_APP=postgresql://hub_app@localhost/contexthub

ANTHROPIC_API_KEY=
# Agent replies and tool choice.
MODEL_ID=claude-sonnet-5-5
# Memory extraction and SUM-baseline grading (cheaper model).
EXTRACTION_MODEL_ID=claude-haiku-5-5
# replay (no network, default) | record | live
LLM_MODE=replay

# A bank callback is Missed when the clock reaches due_at + this many minutes with no dialler record.
MISSED_THRESHOLD_MINUTES=15

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
